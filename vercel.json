{
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "redirects": [
    { "source": "/geek-maps/tennessee-loan-limits", "destination": "/deep-dives/tennessee-loan-limits", "permanent": true },
    { "source": "/geek-maps", "destination": "/deep-dives", "permanent": true }
  ],
  "rewrites": [
    { "source": "/getting-started", "destination": "/" },
    { "source": "/process", "destination": "/" },
    { "source": "/types", "destination": "/" },
    { "source": "/costs", "destination": "/" },
    { "source": "/profile", "destination": "/" },
    { "source": "/structure", "destination": "/" },
    { "source": "/rates", "destination": "/" },
    { "source": "/tools", "destination": "/" },
    { "source": "/tools/:slug*", "destination": "/" },
    { "source": "/geek-log", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ]
}
